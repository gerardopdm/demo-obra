FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

COPY index.html supervision.html construction.html /usr/share/nginx/html/
COPY styles.css supervision.css construction.css /usr/share/nginx/html/
COPY app.js supervision.js construction.js construction-data.js data.js detections.js /usr/share/nginx/html/
COPY assets/ /usr/share/nginx/html/assets/

EXPOSE 80
